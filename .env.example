# Скопируйте этот файл в .env и заполните своими значениями.
# .env НЕ коммитится в git (см. .gitignore) — храните секреты только локально.

# Базовый домен API
WORKZILLA_BASE=https://client.work-zilla.com

# Ваш ID (виден в адресе страницы вида /freelancer/22217250)
WORKZILLA_USER_ID=22217250

# Значение заголовка agentid из запросов браузера
WORKZILLA_AGENT_ID=

# Полная строка Cookie из запроса браузера (значения .AspNetCore.Session, Bearer, BrowserId и т.д.)
# Открыть DevTools -> Network -> любой XHR-запрос к client.work-zilla.com -> скопировать заголовок Cookie целиком
WORKZILLA_COOKIE=

# Эндпоинт, который отдаёт JSON со списком заданий (Новые/Открытые/В очереди/В работе/История).
# По умолчанию используется /api/order/v1/{WORKZILLA_USER_ID} — поменяйте, если он не подойдёт.
WORKZILLA_TASKS_PATH=/api/order/v1/{userId}

# Порт локального сервера
PORT=3000
